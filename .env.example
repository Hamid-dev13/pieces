# Variables de pieces. Les valeurs se renseignent dans le .env du serveur,
# jamais ici : ce fichier est versionné, l'autre non.

# Jeton du bot, donné par @BotFather.
TELEGRAM_TOKEN=

# Comptes Telegram autorisés, séparés par des virgules. Tout le reste est
# ignoré en silence. Ce sont des identifiants numériques, pas des @pseudo :
# @userinfobot donne le sien.
PIECES_ALLOWED_IDS=

# Emplacement des documents et de la base dans le conteneur. La valeur par
# défaut convient ; ne la changer que pour un essai en local.
# PIECES_DATA_DIR=/data

# Cle de l'API Mistral, pour l'OCR des documents scannes. Obligatoire : sans
# elle le bot refuse de demarrer. https://console.mistral.ai/
MISTRAL_API_KEY=
